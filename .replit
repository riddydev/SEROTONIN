entrypoint = "serotonin.py"
modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["rapidfuzz-cpp", "taskflow"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "serotonin.py"]
deploymentTarget = "cloudrun"

[agent]
expertMode = true

[workflows]
runButton = "Telegram Bot"

[[workflows.workflow]]
name = "Telegram Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python serotonin.py"

[workflows.workflow.metadata]
outputType = "console"
